# .env.example — production/staging secret and per-deploy env template.
#
# Every REPLACE_ME below is a placeholder for a real secret; never commit an
# actual secret value to this file or to any config/*.toml (ADR-026,
# Decision 4). The handful of non-REPLACE_ME values (DUBBRIDGE_ENV,
# DUBBRIDGE_TRANSLATION_PROVIDER) are frozen non-secret deploy values
# (S-230-T5a), shown here because they are still env-injected rather than
# committed to a TOML profile. Copy this file to `.env` (untracked) and fill
# in real secret values, or inject these same names directly as process
# environment variables in production/staging.
#
# `AppConfig::load()` (crates/config/src/lib.rs) reads structured settings via
# figment's `DUBBRIDGE_` prefix with `__` as the nesting separator — e.g.
# `DUBBRIDGE_AUTH__ISSUER` maps to `auth.issuer`. A handful of vars below are
# flat (single underscore) because they are read directly by
# `std::env::var(...)` outside AppConfig, or by the Python translation
# worker — those are called out explicitly.

# --- Environment discriminator (required, no compiled default; ADR-026) ---
DUBBRIDGE_ENV=production

# --- Core datastore secrets (flat; read via std::env::var, not figment-nested) ---
DUBBRIDGE_DATABASE_URL=postgres://REPLACE_ME:REPLACE_ME@REPLACE_ME:5432/dubbridge
DUBBRIDGE_REDIS_URL=redis://REPLACE_ME:6379

# --- Storage credentials (DigitalOcean Spaces; figment-nested double
#     underscore, env-only, never in TOML) ---
DUBBRIDGE_STORAGE__ACCESS_KEY_ID=REPLACE_ME
DUBBRIDGE_STORAGE__SECRET_ACCESS_KEY=REPLACE_ME

# NOTE: crates/config/src/lib.rs:260-267 (AppConfig::from_env, deprecated)
# reads single-underscore DUBBRIDGE_STORAGE_ACCESS_KEY_ID/
# DUBBRIDGE_STORAGE_SECRET_ACCESS_KEY instead. AppConfig::load() — the
# production boot path — only reads the double-underscore names above; the
# single-underscore names are dead for production and exist only in the
# legacy from_env() path (Task 4 removal pending).

# --- Auth secrets (figment-nested; AuthSettings). issuer/audience/
#     rsa_public_key_path/jwt_expiry_hours/clock_skew_leeway_seconds are
#     non-secret and live in config/production.toml's [auth] block instead —
#     only the signing secret is env-injected here. ---
DUBBRIDGE_AUTH__JWT_SECRET=REPLACE_ME

# NOTE: crates/config/src/lib.rs:429-449 (AuthSettings::from_env) is a
# legacy, single-underscore reader (DUBBRIDGE_AUTH_ISSUER, DUBBRIDGE_AUTH_AUDIENCE,
# DUBBRIDGE_AUTH_RSA_PUBLIC_KEY_PATH, DUBBRIDGE_AUTH_JWT_SECRET,
# DUBBRIDGE_AUTH_JWT_EXPIRY_HOURS, DUBBRIDGE_AUTH_CLOCK_SKEW_LEEWAY_SECONDS)
# kept only for the deprecated AppConfig::from_env() path (Task 4 removal
# pending). AppConfig::load() — the path every production service uses —
# never reads these single-underscore names. Do not set them; they are dead
# reads for the production boot path and exist here only as a documented
# warning against confusing them with the double-underscore names above.
# rsa_public_key_path is also structurally required but functionally dead:
# auth has been HS256-only since ADR-031/S-200 (crates/auth/src/issuer.rs).

# --- Gateway settings (figment-nested; GatewaySettings, required if gateway runs) ---
DUBBRIDGE_GATEWAY__OAUTH__CLIENT_SECRET=REPLACE_ME

# --- Translation worker (flat; read directly by workers/translation-worker-py/main.py,
#     NOT part of AppConfig/figment — DUBBRIDGE_ prefix is coincidental) ---
# Frozen POC value (S-230-T5a): http provider mode.
DUBBRIDGE_TRANSLATION_PROVIDER=http
DUBBRIDGE_TRANSLATION_API_URL=REPLACE_ME
DUBBRIDGE_TRANSLATION_API_KEY=REPLACE_ME
