# T6d.C1 — partial OpenTofu backend configuration for Cloudflare R2.
#
# Copy to backend.hcl only after the dedicated R2 state bucket exists.
# Never put access_key / secret_key in this file. Export them as
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY for the OpenTofu S3 backend.
#
# R2 account id is non-secret but environment/site specific.

bucket = "REPLACE_WITH_PRIVATE_R2_STATE_BUCKET"
key    = "dubbridge/poc-v1/opentofu.tfstate"
region = "auto"

endpoints = {
  s3 = "https://REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com"
}

use_path_style              = true
skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_s3_checksum            = true

# Deliberately omitted:
# use_lockfile — C0 does not assume R2 conditional-write lock compatibility.
