{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dubbridge.local/schemas/context-receipt-v1.schema.json",
  "title": "DubBridge Context Receipt v1",
  "type": "object",
  "required": [
    "schema",
    "task",
    "repository",
    "target",
    "anchors",
    "impact",
    "boundaries",
    "governance",
    "export",
    "excluded",
    "expansions",
    "capsule_sha256",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "context-receipt-v1"},
    "task": {
      "type": "object",
      "required": ["id", "description"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": ["git_revision", "graph_revision"],
      "properties": {
        "git_revision": {"type": "string", "minLength": 1},
        "graph_revision": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "target": {"enum": ["local", "cloud"]},
    "anchors": {"type": "array", "items": {"type": "string"}},
    "impact": {
      "type": "object",
      "required": ["files", "symbols", "tests"],
      "properties": {
        "files": {"type": "array", "items": {"type": "string"}},
        "symbols": {"type": "array", "items": {"type": "string"}},
        "tests": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "boundaries": {"type": "array", "items": {"type": "string"}},
    "governance": {"type": "array", "items": {"type": "string"}},
    "export": {
      "type": "object",
      "required": [
        "files",
        "symbols",
        "tests",
        "anchors",
        "boundaries",
        "governance",
        "source_fragments"
      ],
      "properties": {
        "files": {"type": "array", "items": {"type": "string"}},
        "symbols": {"type": "array", "items": {"type": "string"}},
        "tests": {"type": "array", "items": {"type": "string"}},
        "anchors": {"type": "array", "items": {"type": "string"}},
        "boundaries": {"type": "array", "items": {"type": "string"}},
        "governance": {"type": "array", "items": {"type": "string"}},
        "source_fragments": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "excluded": {"type": "object"},
    "expansions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["base_receipt_sha256", "reason", "decision", "added"],
        "properties": {
          "base_receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reason": {"type": "string", "minLength": 1},
          "decision": {"enum": ["allow", "reduce", "deny"]},
          "added": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "capsule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
